# Forgejo + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# FORGEJO_IMAGE_TAG=codeberg.org/forgejo/forgejo:16.0.4@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.forgejo.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Forgejo
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname. Must resolve to this server's public IP for the
# Let's Encrypt TLS-ALPN challenge. REQUIRED.
#
# It is also written into every clone URL and every link in notification mail.
# Changing it later means the URLs already handed out stop working, so decide
# now rather than after people have cloned.
FORGEJO_HOSTNAME=git.example.com

# There is no admin password to set here, and that is deliberate. The web
# installer is locked (INSTALL_LOCK), so nobody who finds the hostname before
# you do can configure the instance. Create the account from the CLI once the
# stack is up:
#
#   docker compose -f forgejo-traefik-letsencrypt-docker-compose.yml -p forgejo \
#     exec -u git forgejo forgejo admin user create \
#     --admin --username YOUR_NAME --email you@example.com --random-password
#
# It prints the password once. Sign in, change it, enable 2FA.

# Sign-up and visibility. The defaults make this a private instance: nobody
# can create an account, and nothing is visible without signing in. Open
# either one deliberately, not by accident.
# FORGEJO_DISABLE_REGISTRATION=true
# FORGEJO_REQUIRE_SIGNIN_VIEW=true

# Forgejo Actions (the CI half). Enabled means the feature exists; nothing
# runs until you register a runner. A runner polls outward, so it needs no
# inbound connection and no public address of its own.
# FORGEJO_ACTIONS_ENABLED=true

# The uid/gid the container runs as, and which the files in the data volume
# are owned by. Change only if you bind-mount a host directory owned by
# different numbers.
# FORGEJO_UID=1000
# FORGEJO_GID=1000

# Timezone used for timestamps and scheduled tasks.
# FORGEJO_TZ=Etc/UTC

# Log level: trace, debug, info, warn, error. Default: info.
# FORGEJO_LOG_LEVEL=info

# How long Traefik will hold a single git request or response open. Packing a
# large repository server-side can take minutes before the first byte comes
# back, so the default is 0 — no limit. Raise the idle timeout instead if you
# want abandoned connections reaped sooner.
# FORGEJO_GIT_TIMEOUT=0s
# FORGEJO_IDLE_TIMEOUT=600s

# ──────────────────────────────────────────────────────────────────────────────
# Git over SSH (only with git-over-ssh.override.yml)
# ──────────────────────────────────────────────────────────────────────────────
#
# Read ONLY when you add that file to the command line. The base stack serves
# git over HTTPS, which needs no extra port. This is the host port the
# container's SSH server is published on — 22 belongs to the host's own sshd.
#
# FORGEJO_SSH_PORT=2222

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────
#
# The archive covers /data, which is the whole instance: the git repositories,
# the SQLite database holding users, issues, pull requests, access tokens and
# webhooks, app.ini, avatars, attachments and the LFS store.

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# DATA_BACKUP_PRUNE_DAYS=7
# DATA_BACKUPS_PATH=/srv/forgejo-data/backups
# DATA_PATH=/data
# DATA_BACKUP_NAME=forgejo-data-backup

# Resource limits (defaults shown). What moves these is not the number of
# users: it is `git gc` on a large repository and the code indexer, both of
# which are bursty.
# FORGEJO_MEMORY_LIMIT=2g
# FORGEJO_CPU_LIMIT=2.0
# FORGEJO_MEMORY_RESERVATION=256m
# FORGEJO_CPU_RESERVATION=0.2
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# FORGEJO_BACKUPS_MEMORY_LIMIT=256m
# FORGEJO_BACKUPS_CPU_LIMIT=0.5
# FORGEJO_BACKUPS_MEMORY_RESERVATION=16m
# FORGEJO_BACKUPS_CPU_RESERVATION=0.1

# How long docker waits before SIGKILL. SQLite tolerates a hard kill far worse
# than it looks, and a push interrupted mid-transaction can leave a repository
# the database references and the disk does not have.
# FORGEJO_STOP_GRACE_PERIOD=60s

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image while every other pin stays as tested. Needs Docker
# Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# FORGEJO_IMAGE_VERSION=16.0.4
# FORGEJO_BACKUPS_IMAGE_VERSION=3.22
